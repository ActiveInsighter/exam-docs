{
  "name": "exam-docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-git-history.mjs && node scripts/patch-mermaid-block-layout.mjs && node scripts/patch-fumadocs-sidebar.mjs && fumadocs-mdx",
    "search:build": "node scripts/build-search-index.mjs public/search-index.json",
    "dev": "npm run search:build && next dev",
    "build": "npm run search:build && next build",
    "build:static-docs": "node scripts/prepare-static-build-cache.mjs && node scripts/run-static-docs-build.mjs && node scripts/write-docs-entry.mjs && node scripts/dedupe-static-rsc.mjs && node scripts/analyze-static-output.mjs",
    "prepare:cloudflare-assets": "node scripts/prepare-cloudflare-static-assets.mjs",
    "build:cloudflare-assets": "npm run build:static-docs && npm run prepare:cloudflare-assets",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "hast-util-to-html": "^9.0.5",
    "katex": "0.19.1",
    "lucide-react": "^1.61.0",
    "mermaid": "12.2.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zbsearch": "4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@electric-sql/pglite": "0.5.11",
    "@next/env": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "blake3-wasm": "2.1.5",
    "fake-indexeddb": "6.2.6",
    "mime": "4.1.1",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "rehype-katex": {
      "katex": "$katex"
    }
  }
}
